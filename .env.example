# 仅供手动 pnpm verify:model 使用；自动测试不会读取 .env。
# 复制为 .env 后在本机编辑。不要把 .env 或密钥上传至 GitHub。
SHOUWEI_BASE_URL=
SHOUWEI_MODEL_ID=
SHOUWEI_API_KEY=
# 请按你的模型真实容量填写，不使用猜测的默认模型窗口。
SHOUWEI_CONTEXT_WINDOW=
SHOUWEI_MAX_OUTPUT_TOKENS=
SHOUWEI_TIMEOUT_MS=60000
# 只有显式无鉴权的本机服务才填 1；将使用公开占位 Authorization。
SHOUWEI_NO_CREDENTIAL=0
